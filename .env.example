# ===== LLM (Caption Generator) =====
# Get a free API key at https://aistudio.google.com/apikey
# (no credit card required for the free tier)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ===== Backend =====
DATABASE_URL=sqlite:///./data/ig_autopilot.db
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== Frontend =====
VITE_API_BASE_URL=http://localhost:8000

# ===== Phase 2: Instagram automation =====
# Default DRY_RUN=true means Phase 2 plans actions and writes to InteractionLog
# but does NOT actually like/comment/follow on IG. Set false ONLY when ready
# to risk a real account.
IG_DRY_RUN=true

# Real IG credentials — only needed when IG_DRY_RUN=false. Use a TEST account
# first; auto-actions can trigger IG account bans.
# IG_USERNAME=
# IG_PASSWORD=
# IG_PROXY=

# Sweep schedule — comma-separated hours in 24h format (server TZ)
SWEEP_HOURS=0,8,16

# Default safety caps per IG account (override per-account via UI if needed)
DAILY_ACTION_CAP=120
LIKE_RATIO=0.9
ACTION_DELAY_MIN_SEC=30
ACTION_DELAY_MAX_SEC=300
