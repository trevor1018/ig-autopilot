# ===== LLM (Caption Generator) =====
# Get a free API key at https://aistudio.google.com/apikey
# (no credit card required for the free tier)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ===== Backend =====
DATABASE_URL=sqlite:///./data/ig_autopilot.db
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== Frontend =====
VITE_API_BASE_URL=http://localhost:8000

# ===== Phase 2: Instagram automation =====
# Three modes (precedence: DRY_RUN > READ_ONLY > LIVE):
#
#   DRY_RUN=true                   → No login. Synthetic posts. Zero risk.
#   DRY_RUN=false + READ_ONLY=true → Real login + real post fetch. SKIPS
#                                    actual like/comment writes. Use this
#                                    to validate target reactions on a TEST
#                                    account before going live.
#   DRY_RUN=false + READ_ONLY=false → Full live. Real likes / comments. Test
#                                     account first, low cap, watch carefully.
IG_DRY_RUN=true
IG_READ_ONLY=false

# IG credentials — needed when DRY_RUN=false (both read-only and live).
# Use a TEST account, never your main 暖暖豬 account, until you have weeks
# of clean operation.
# IG_USERNAME=
# IG_PASSWORD=
# IG_PROXY=

# Sweep schedule — comma-separated hours in 24h format (server TZ)
SWEEP_HOURS=0,8,16

# Default safety caps per IG account (override per-account via UI if needed)
DAILY_ACTION_CAP=120
LIKE_RATIO=0.9
ACTION_DELAY_MIN_SEC=30
ACTION_DELAY_MAX_SEC=300
